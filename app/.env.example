# Copy to app/.env.local for local development. In Vercel, set these per environment
# (Preview = staging Supabase project, Production = production project). Never commit real values.

# Supabase project settings -> API. The anon key is public; it can only execute public.ff_* commands.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical site origin used for sign-in redirects and invitation links (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3200

# Server-only: 64 hex characters (openssl rand -hex 32). Distinct per environment. Encrypts QR pass tokens.
PASS_ENCRYPTION_KEY=
